{
  "name": "coach-desktop",
  "version": "1.0.0",
  "description": "KOÇ Özel Ders Takip Masaüstü Uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.ozelders.desktop",
    "productName": "KOÇ",
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KOÇ",
      "artifactName": "koc-setup.${ext}"
    },
    "portable": {
      "artifactName": "koc-app.${ext}"
    },
    "directories": {
      "output": "../dist-desktop"
    }
  },
  "dependencies": {
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
